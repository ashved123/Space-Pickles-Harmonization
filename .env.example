# Copy to .env and fill in. Never commit .env.

# Required. NASA FIRMS MAP_KEY (free, emailed instantly).
# Get it: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Required for NDVI (MOD13Q1 from LP DAAC). NASA Earthdata Login bearer token.
# 1. Sign up: https://urs.earthdata.nasa.gov/users/new
# 2. Log in -> "Generate Token" (valid 60 days).
EARTHDATA_TOKEN=

# Optional. Only if we pull Copernicus GLO-30 through OpenTopography instead of
# the keyless AWS open-data bucket or USGS 3DEP.
# Get it: https://portal.opentopography.org/ -> MyOpenTopo -> Request API key
OPENTOPO_API_KEY=
